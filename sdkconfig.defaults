# ESP32 BT Dongle: controller-only, dual mode, H4 over UART0 (bridged from VHCI in h4_bridge.c)
CONFIG_IDF_TARGET="esp32"

# Bluetooth: controller only, Classic + LE
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BTDM_CTRL_HCI_MODE_VHCI=y
# A2DP speaker + up to 3 Classic pads (+ spare); LE pads
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=7
CONFIG_BTDM_CTRL_BLE_MAX_CONN=4
# No SCO/eSCO (no headset audio): frees controller memory
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=0
CONFIG_BTDM_CTRL_BR_EDR_SCO_DATA_PATH_HCI=y
# Keep BLE links from starving the A2DP stream
CONFIG_BTDM_CTRL_AUTO_LATENCY=y
# No sleep: the host has no wake line
CONFIG_BTDM_CTRL_MODEM_SLEEP=n
# Adv report flow control is an Espressif vendor command a foreign host never sends
CONFIG_BTDM_BLE_ADV_REPORT_FLOW_CTRL_SUPP=n
CONFIG_BTDM_CTRL_PINNED_TO_CORE_0=y

# UART0 carries HCI: no console, no logs on it
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_ESP_SYSTEM_PANIC_SILENT_REBOOT=y

CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# UART RX interrupt must not wait for flash
CONFIG_UART_ISR_IN_IRAM=y
